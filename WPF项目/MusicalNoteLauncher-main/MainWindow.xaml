<Window x:Class="MusicalNoteLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MNL" Height="700" Width="1100"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="pack://application:,,,/Assets/图标.png">

    <Grid>
            <!-- Layer 0: 背景装饰层（图片 + 视频 + 模糊效果） -->
            <Grid x:Name="BackgroundLayer" Panel.ZIndex="0">
                <Image x:Name="BackgroundImage"
                       Stretch="UniformToFill" Source="{x:Null}"
                       Opacity="0.6" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="LowQuality"
                       CacheMode="BitmapCache">
                    <Image.Effect>
                        <BlurEffect x:Name="BackgroundImageBlur" Radius="0"
                                    RenderingBias="Quality" />
                    </Image.Effect>
                </Image>
                <MediaElement x:Name="BackgroundVideo"
                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              Stretch="UniformToFill" Volume="0"
                              Opacity="0.6" Visibility="Collapsed"
                              ScrubbingEnabled="False"
                              MediaOpened="BackgroundVideo_MediaOpened"
                              MediaFailed="BackgroundVideo_MediaFailed"
                              MediaEnded="BackgroundVideo_MediaEnded">
                    <MediaElement.Effect>
                        <BlurEffect x:Name="BackgroundVideoBlur" Radius="0"
                                    RenderingBias="Quality" />
                    </MediaElement.Effect>
                </MediaElement>
            </Grid>

            <!-- Layer 1: WebView2 前端 UI -->
            <wv2:WebView2 x:Name="WebView" Panel.ZIndex="1"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           DefaultBackgroundColor="Transparent" />

            <!-- Layer 2: 全局音频播放器 -->
            <MediaElement x:Name="GlobalMediaPlayer" Visibility="Collapsed"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Panel.ZIndex="99"/>
        </Grid>
</Window>
