<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MNL</AssemblyName>
    <Version>1.2.2.0</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <RootNamespace>MusicalNoteLauncher</RootNamespace>
    <ApplicationIcon>..\Assets\图标.ico</ApplicationIcon>

    <!-- 平台条件 -->
    <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
    <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
    <IsMacOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsMacOS>
    <DefineConstants Condition="'$(IsWindows)' == 'true'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(IsLinux)' == 'true'">$(DefineConstants);LINUX</DefineConstants>
    <DefineConstants Condition="'$(IsMacOS)' == 'true'">$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.1.22" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpCompress" Version="0.38.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>

  <!-- System.Management 仅 Windows -->
  <ItemGroup Condition="'$(IsWindows)' == 'true'">
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- ═══ 链接共享源代码 ═══ -->
  <ItemGroup>
    <!-- Core -->
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\Core\PCL\**\*.cs" Link="Core\PCL\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Utils -->
    <Compile Include="..\Utils\*.cs" Link="Utils\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- WebApp 资源文件 -->
  <ItemGroup>
    <Content Include="..\WebApp\**\*" Exclude="..\WebApp\test-step.html;..\WebApp\test-vue.html;..\WebApp\pages\mods.js;..\WebApp\pages\versions.js;..\WebApp\vue.global.prod.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WebApp\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- 其他资源 -->
  <ItemGroup>
    <Content Include="..\Assets\Skins\steve.png" CopyToOutputDirectory="PreserveNewest" Link="Assets\Skins\steve.png" />
    <Content Include="..\Assets\Skins\alex.png" CopyToOutputDirectory="PreserveNewest" Link="Assets\Skins\alex.png" />
    <Content Include="..\Assets\moddata.txt" CopyToOutputDirectory="PreserveNewest" Link="Assets\moddata.txt" />
  </ItemGroup>

</Project>
