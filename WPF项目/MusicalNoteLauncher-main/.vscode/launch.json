{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MusicalNoteLauncher (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/MusicalNoteLauncher.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "requireExactSource": false
        },
        {
            "name": "测试: 模拟普通更新",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/MusicalNoteLauncher.dll",
            "args": ["--test-update"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "requireExactSource": false
        },
        {
            "name": "测试: 模拟强制更新",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/MusicalNoteLauncher.dll",
            "args": ["--test-forced-update"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "requireExactSource": false
        }
    ]
